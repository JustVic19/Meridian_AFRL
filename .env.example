# Environment variable template for Meridian AFRL
#
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control.
#
# Each secret is consumed via `os.getenv()` or `python-dotenv`.
# The application must degrade gracefully when variables are absent in test mode.

# ---------------------------------------------------------------------------
# AI / LLM providers  (leave blank to use mock providers in tests)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Market data providers  (leave blank to use mock adapters in tests)
# ---------------------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
QUANDL_API_KEY=

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///meridian_afrl.db
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Set to "test" to activate mock providers automatically
MERIDIAN_ENV=development
