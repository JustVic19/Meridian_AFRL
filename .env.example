# Local development defaults. Copy to `.env` only if you need to override them.
# `docker compose up` works without this file.
# NEVER commit `.env`. These values are the local Postgres role, not broker credentials.

POSTGRES_USER=afil
POSTGRES_PASSWORD=afil_local_dev
POSTGRES_DB=afil

# Used by the API on the host. Inside Compose, the API uses the postgres hostname.
DATABASE_URL=postgresql+psycopg://afil:afil_local_dev@localhost:5433/afil

# Required before a live SEC request. EDGAR fair-access policy requires a
# descriptive User-Agent. Leave this empty in the example; do not commit one.
SEC_USER_AGENT=

